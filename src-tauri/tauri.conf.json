{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bull Monitor",
  "version": "0.3.0",
  "identifier": "dev.renan.bullmonitor",
  "build": {
    "frontendDist": "../loading",
    "beforeDevCommand": "bun run build:sidecar",
    "beforeBuildCommand": "bun run build:sidecar && bun run build:notices"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bull-monitor-sidecar"
    ],
    "resources": {
      "resources/bull-board-ui/": "bull-board-ui/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Renan Nunes",
    "publisher": "Renan Nunes"
  }
}
